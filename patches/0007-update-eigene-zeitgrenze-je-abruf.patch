+// getBounded is get with manifestTimeout of its own, so that one slow fetch does not eat the time
+// the next one needs. A caller that already has a deadline keeps it: the shorter of the two wins,
+// which is what context.WithTimeout does.
+func getBounded(ctx context.Context, url string, max int64) ([]byte, error) {
+	ctx, cancel := context.WithTimeout(ctx, manifestTimeout)
+	defer cancel()
+	return get(ctx, url, max)
+}
