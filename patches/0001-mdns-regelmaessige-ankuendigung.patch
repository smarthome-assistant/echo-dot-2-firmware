+// announceEvery is how often the device announces itself when nothing has changed.
+//
+// Without this the record went out once, at the registration, and then only when an address or the key
+// changed. Answering a query still worked — but only a query the device hears, and on this radio it
+// does not always hear one: after a group-key rekey the Wi-Fi firmware drops every group-addressed
+// frame it receives, for minutes at a time (techo5-dot#45; measured here on 19.11.2026, three minutes
+// answered and then ten minutes silent, with the firmware's md5 the same as the one in that report).
+// A query that arrives in such a window is never heard and never answered, so a device that had been
+// up for hours was found only by a Home Assistant that happened to ask while the device was listening.
+//
+// Sending is not affected by that fault — only receiving is. An unprompted announcement therefore
+// reaches Home Assistant even while the device is deaf, which is the whole point of sending one.
+//
+// Three minutes. The records are served with zeroconf's default TTL of 3200 s, so this is not about
+// keeping them from expiring: what a browser already holds stands for the best part of an hour. It is
+// about reaching a Home Assistant that was not listening before — one that has just started, or just
+// had its zeroconf restarted, and whose own queries fell into a deaf window. Each announcement is a
+// goodbye and a fresh record a moment apart (goodbyeGap), the shape the code already used after a
+// move: a browser takes it as the device gone and back, which is what makes Home Assistant offer it
+// again. A device already added talks over its own connection and does not care. At this pace it is
+// a few hundred bytes every three minutes.
+const announceEvery = 3 * time.Minute
+
+// announceAgainAfter is how long the current registration stands before it is made again: the shorter
+// follow-up pace for a while after a move, otherwise the steady announceEvery. Zero means never —
+// the registration stands and the device still answers queries, it just says nothing unprompted.
+//
+// The follow-up after a move is kept even with announcements switched off: it is not the steady
+// announcement but the device telling Home Assistant where it went, without which a device that
+// changed address is lost to it until something restarts.
+func announceAgainAfter(movedAt time.Time) time.Duration {
+	if !movedAt.IsZero() && time.Since(movedAt) < followMove {
+		return followEvery
+	}
+	if !config.Get().Discovery.Announces() {
+		return 0
+	}
+	return announceEvery
+}
+
 // movedGap is how long a device that changed address stays unannounced: longer than Home Assistant's
 // keepalive (aioesphomeapi: 20 s pings, given up after 4.5 of them) takes to drop the old connection.
 const movedGap = 2 * time.Minute
