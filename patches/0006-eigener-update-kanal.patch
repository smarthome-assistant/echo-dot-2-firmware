@@ -4,4 +4,12 @@ package update
 
 // releases is where the Echo Dot's releases are published: a project of its own, so a Dot release never
 // becomes the Show's "latest", and the Show's never the Dot's.
-const releases = "https://github.com/HuskerMinion/techo5-dot/releases"
+//
+// Pointed at our own fork (20 Nov 2026). The upstream channel is
+// https://github.com/HuskerMinion/techo5-dot/releases, and a build that follows it is a one-line
+// change away — but the two cannot be mixed: releaseKey in trust.go is ours, so a unit running this
+// build refuses upstream manifests and vice versa. Switching either way means flashing by hand.
+//
+// What is published here are our own builds of this source with the patches that live beside it:
+// nothing from Amazon, and the upstream MIT notice travels with them.
+const releases = "https://github.com/smarthome-assistant/echo-dot-2-firmware/releases"
