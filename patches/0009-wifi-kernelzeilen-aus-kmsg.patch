diff --git a/echod/internal/lib/wifi/kmsg_test.go b/echod/internal/lib/wifi/kmsg_test.go
new file mode 100644
index 00000000..a0909709
--- /dev/null
+++ b/echod/internal/lib/wifi/kmsg_test.go
@@ -0,0 +1,34 @@
+package wifi
+
+import (
+	"strings"
+	"testing"
+)
+
+// A /dev/kmsg record comes out in dmesg's shape, so kernelEvidence keeps the same lines from either.
+func TestKmsgLineIsDmesgShaped(t *testing.T) {
+	rec := "6,4711,24091003540,-;[wlan]kalIndicateStatusAndComplete:(AIS INFO) wlan0 netif_carrier_on [ssid:Our Home]\n SUBSYSTEM=net\n DEVICE=n3\n"
+	got, ok := kmsgLine(rec)
+	if !ok || got != "[24091.003540] [wlan]kalIndicateStatusAndComplete:(AIS INFO) wlan0 netif_carrier_on [ssid:Our Home]" {
+		t.Fatalf("got %q, %v", got, ok)
+	}
+	if strings.Contains(got, "SUBSYSTEM") {
+		t.Errorf("a dictionary line was kept: %q", got)
+	}
+	lines := kernelEvidence(got+"\n", 8)
+	if len(lines) != 1 || strings.Contains(lines[0], "Our Home") || !strings.Contains(lines[0], "24091.003540") {
+		t.Errorf("kernelEvidence on a kmsg line: %q", lines)
+	}
+	if got, _ := kmsgLine("12,1,7,c;x"); got != "[    0.000007] x" {
+		t.Errorf("small time: %q", got)
+	}
+}
+
+// A record that is not one is left out rather than guessed at.
+func TestKmsgLineRefusesWhatIsNotARecord(t *testing.T) {
+	for _, rec := range []string{"", "no semicolon here", "6,1;short head", "6,1,soon,-;text"} {
+		if got, ok := kmsgLine(rec); ok {
+			t.Errorf("%q read as %q", rec, got)
+		}
+	}
+}
