+//go:build !dot
+
+package setup
+
+import "net/http"
+
+// The switch to Fire OS is the Echo Dot's: it is the board whose Fire OS stayed in the system
+// partitions when this firmware went into recovery (toalexa_dot.go). The Show's layout is another,
+// so the card is not offered there.
+
+func toAlexaSection(http.ResponseWriter, string) {}
+
+func saveToAlexa(*http.Request) string { return "this device has no switch to Fire OS" }
